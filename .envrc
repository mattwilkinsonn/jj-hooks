# Auto-loads the devenv shell (devenv.nix) on cd into the repo — the full
# dev + CI toolchain. Run `direnv allow` once.
#
# The source_url line pulls devenv's direnv integration (`use devenv`) at a
# pinned rev, so this works without a globally-installed devenv direnvrc.
source_url "https://raw.githubusercontent.com/cachix/devenv/82c0147677e510b247d8b9165c54f73d32dfd899/direnvrc" "sha256-7u4iDd1nZpxL4tCzmPG0dQgC5V+/44Ba+tHkPob1v2k="

use devenv

# Per-workspace overrides (gitignored). A secondary jj workspace drops a
# .envrc.local here pointing GIT_DIR at the primary repo's .git, so git-aware
# tools work without a local .git.
source_env_if_exists .envrc.local
